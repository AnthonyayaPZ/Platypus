NODE_ENV=production
APP_DOMAIN=words.example.com

POSTGRES_DB=platypus_words
POSTGRES_USER=platypus
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://platypus:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/platypus_words
DATABASE_POOL_MAX=10
DATABASE_SSL=disable

API_KEY=CHANGE_ME
BASE_URL=https://api.example.com/v1
MODEL_NAME=CHANGE_ME

# Internal caption downloader; never publish its port.
CAPTIONS_SERVICE_URL=http://captions:8080
CAPTIONS_SERVICE_TOKEN=CHANGE_ME_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_24_CHARACTERS
# Optional outbound HTTP(S) proxy for the captions container, configured by the operator.
CAPTIONS_PROXY=
# Optional operator-provided YouTube-only Netscape cookie file, mounted read-only.
# Systemd deployments should use deploy/systemd/70-caption-cookies.conf instead.
CAPTIONS_COOKIES_FILE=
VIDEO_STUDY_MAX_SECONDS=3600
VIDEO_STUDY_CONCURRENCY=2
